# ==========================================================================
# backeend.com.br — configuração Apache
#
# ⚠️  ATENÇÃO — CLOUDFLARE
# Este site está atrás do Cloudflare. O Cloudflare conecta ao servidor de
# origem por HTTP interno. Por isso NÃO se deve forçar HTTPS aqui:
# a regra "%{HTTPS} off" enxerga sempre HTTP e cria um LOOP infinito
# (ERR_TOO_MANY_REDIRECTS). O HTTPS é responsabilidade do Cloudflare.
#
# Se um dia o Cloudflare sair da frente, aí sim dá para reativar o
# redirecionamento de HTTPS (bloco comentado no fim do arquivo).
# ==========================================================================

Options -Indexes
# index.html tem prioridade na raiz; nas pastas do sistema (/cliente, /app,
# /totem...) o index.php/login.php continua funcionando. Sem os nomes abaixo,
# essas pastas respondem 403 por causa do "Options -Indexes".
# ATENÇÃO: não use underline (index.php_) nem deixe só "index.php".
DirectoryIndex index.html index.php index.htm login.php

# --------------------------------------------------------------------------
# 1. Host canônico (www) — sem mexer em HTTPS
# --------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^backeend\.com\.br$ [NC]
  RewriteRule ^ https://www.backeend.com.br%{REQUEST_URI} [L,R=301]

  # /index.php e /index.html -> /
  RewriteCond %{THE_REQUEST} \s/+index\.(php|html)[?\s] [NC]
  RewriteRule ^ / [R=301,L]

  # Links antigos do template
  RewriteRule ^services-details\.html$ /totem-de-pesquisa-de-satisfacao.html [R=301,L]
  RewriteRule ^service-details\.html$ /totem-de-pesquisa-de-satisfacao.html [R=301,L]
  RewriteRule ^portfolio-details\.html$ /segmentos.html [R=301,L]
</IfModule>

# --------------------------------------------------------------------------
# 2. Página 404 real
# --------------------------------------------------------------------------
ErrorDocument 404 /404.html

# --------------------------------------------------------------------------
# 3. Cabeçalhos de segurança
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --------------------------------------------------------------------------
# 4. Compressão
# --------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# --------------------------------------------------------------------------
# 5. Cache
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# --------------------------------------------------------------------------
# 6. Tipos MIME e charset
# --------------------------------------------------------------------------
AddType image/webp .webp
AddType image/svg+xml .svg
AddType application/xml .xml
AddDefaultCharset UTF-8

# --------------------------------------------------------------------------
# 7. Não servir arquivos de build
# --------------------------------------------------------------------------
<FilesMatch "\.(mjs|md)$">
  Require all denied
</FilesMatch>

# ==========================================================================
# Só use os blocos abaixo se o Cloudflare for REMOVIDO (DNS laranja -> cinza)
# ==========================================================================
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off [OR]
#   RewriteCond %{HTTP_HOST} !^www\.backeend\.com\.br$ [NC]
#   RewriteRule ^ https://www.backeend.com.br%{REQUEST_URI} [L,R=301]
# </IfModule>
