# ==========================================================================
# backeend.com.br — redirecionar para beend.tech (mantendo o login)
#
# Use este arquivo na hospedagem do backeend.com.br DEPOIS de publicar o
# site em beend.tech. Ele:
#   - mantém /cliente, /app/, /totem/ e /totempro/ funcionando aqui
#   - manda TODO o resto (com o caminho) para https://beend.tech
#
# ⚠️ As exceções usam a barra final ("/totem/") de propósito.
# Com "^/totem" (sem barra) o redirecionamento também pegaria
# /totem-de-pesquisa-de-satisfacao.html — uma página do site,
# que passaria a dar 404 no servidor antigo.
# ==========================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Exceções: não redirecionar estas áreas ---
  RewriteCond %{REQUEST_URI} ^/cliente [NC,OR]
  RewriteCond %{REQUEST_URI} ^/app/ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/totem/ [NC,OR]
  RewriteCond %{REQUEST_URI} ^/totempro/ [NC]
  RewriteRule ^ - [L]

  # --- Todo o resto vai para beend.tech, preservando o caminho ---
  RewriteRule ^ https://beend.tech%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 https://beend.tech/404.html
