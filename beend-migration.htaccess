# ==========================================================================
# backeend.com.br — redirecionar o SITE para beend.tech
# mantendo TODAS as áreas e serviços funcionando aqui.
#
# ► SUBIR ESTE ARQUIVO COM O NOME EXATO:  .htaccess
#   (na raiz do backeend.com.br — o mesmo lugar do index.html)
#
# ► Antes, renomeie o .htaccess atual para  .htaccess.bak
#
# Regra: só o SITE (home, páginas .html, blog, assets e arquivos de SEO) vai
# para beend.tech. Aplicações, loja, e-mails e painéis continuam aqui.
# ==========================================================================

# ---- essenciais para as aplicações (sem isto, /cliente dá 403) ----
Options -Indexes
DirectoryIndex index.html index.php index.htm login.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ------------------------------------------------------------------------
  # 1. ÁREAS QUE FICAM AQUI (não redirecionar)
  #    O padrão "(/|$)" garante que "/totem" e "/totem/..." ficam,
  #    mas "/totem-de-pesquisa-de-satisfacao.html" NÃO é capturado —
  #    essa é uma página do site e precisa ir para o beend.tech.
  # ------------------------------------------------------------------------
  RewriteCond %{REQUEST_URI} ^/(cliente|totem|totempro|beta|app|web|api|webmail|cpanel|loja|img|css|js|medias|assets)(/|$) [NC]
  RewriteRule ^ - [L]

  # ------------------------------------------------------------------------
  # 2. TODO O RESTO É O SITE → vai para beend.tech (preservando o caminho)
  #    Inclui: / , /*.html , /blog/ , /robots.txt , /sitemap.xml ,
  #            /llms.txt , /404.html , /google*.html
  # ------------------------------------------------------------------------
  RewriteRule ^ https://beend.tech%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 https://beend.tech/404.html
